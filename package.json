{
  "name": "@jonverrier/c4-auto",
  "version": "0.1.1",
  "description": "Automated C4 architecture documentation for TypeScript projects",
  "private": false,
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonverrier/C4-Auto.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "generate-docs": "ts-node --require tsconfig-paths/register src/generate-docs-cli.ts",
    "test": "jest --selectProjects unit",
    "test:ci": "jest --selectProjects ci",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "cover": "jest --selectProjects ci --coverage --coverageReporters=html text lcov"
  },
  "dependencies": {
    "@jonverrier/prompt-repository": "^0.3.23",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.10",
    "@types/sinon": "^17.0.3",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "sinon": "^19.0.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
